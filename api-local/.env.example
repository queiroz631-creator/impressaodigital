# API local da loja — copie para .env e preencha. NUNCA versionar o .env.

# ---- SQL Server (Lojamix) ----
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=Lojamix
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_TIMEOUT=15
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes

# ---- Sistema (nuvem) ----
# URL base do sistema e token interno das rotinas de sincronização.
SISTEMA_URL=https://project--794a07c8-8935-4198-8eda-84887ff3d9f1.lovable.app
SISTEMA_TOKEN=
SISTEMA_TIMEOUT=30

# ---- API local ----
# Token exigido nas rotas /api/sync/* desta API (não é o token do sistema).
API_LOCAL_TOKEN=
LOTE_TAMANHO=100
LOTE_MAXIMO_CICLOS=10
REVISAO_BLOCO=500
CONSUMIDOR_CLIENTES=api-local-loja
ESTADO_ARQUIVO=./estado/estado.json
LOG_NIVEL=INFO

# Escrita no SQL Server (clientes vindos do sistema). Mantenha false até validar.
ESCRITA_SQLSERVER_HABILITADA=false
