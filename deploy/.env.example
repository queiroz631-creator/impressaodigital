# =============================================================================
# Modelo de variáveis de ambiente para a VPS.
# Copie para a raiz do projeto:  cp deploy/.env.example .env
# =============================================================================

# --- Supabase self-hosted (o banco que ficará na VPS) ---
# URL pública do Supabase (Kong) — use o subdomínio configurado no Nginx:
SUPABASE_URL=https://db.seudominio.com
# Chave "anon" (JWT) gerada na configuração do Supabase self-hosted:
SUPABASE_PUBLISHABLE_KEY=COLE_AQUI_A_ANON_KEY
# Chave "service_role" (JWT) gerada na configuração do Supabase self-hosted:
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY

# Mesmas informações para o lado do navegador (precisam existir no build):
VITE_SUPABASE_URL=https://db.seudominio.com
VITE_SUPABASE_PUBLISHABLE_KEY=COLE_AQUI_A_ANON_KEY
VITE_SUPABASE_PROJECT_ID=default

# --- Endereço público do site ---
# Usado nos links de currículo e orçamento enviados ao cliente:
SITE_URL=https://seudominio.com

# --- Z-API (WhatsApp) — mesmas credenciais já usadas hoje ---
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- Inteligência artificial (currículo, transcrição de áudio e bot) ---
# Na VPS, gere uma chave GRATUITA do Google Gemini em https://aistudio.google.com
# (botão "Get API key") e cole abaixo. Sem ela, a importação de currículo,
# a transcrição de áudio e a interpretação das respostas do bot NÃO funcionam
# fora do ambiente Lovable (a LOVABLE_API_KEY só funciona dentro do Lovable).
GEMINI_API_KEY=
